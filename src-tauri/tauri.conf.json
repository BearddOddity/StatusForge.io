{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StatusForge.io",
  "version": "1.0.8",
  "identifier": "com.bearddoddity.statusforge",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "StatusForge.io",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "hiddenTitle": false,
        "visible": true,
        "url": "index.html"
      },
      {
        "label": "spark",
        "title": "Spark",
        "width": 380,
        "height": 260,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "transparent": true,
        "url": "spark.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' http://127.0.0.1:53735 ws://127.0.0.1:53735; font-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": ["**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../presence.py": "",
      "../forge_scanner.py": "",
      "../spark.py": "",
      "../presence/": "presence/",
      "../widgets/": "widgets/",
      "../Config.json": "",
      "../Forge_Database.json": "",
      "../public/": "public/"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
