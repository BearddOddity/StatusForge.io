# Ignore Security Keys
*.pem
*.key
*.p12
*.keystore
.env
.env.*

# Ignore Node and Build folders
node_modules/
dist/

# Ignore local Python builds and caches
presence.exe
presence
presence.app
presence.spec
__pycache__/
build/presence/

# Ignore local databases, logs, and tokens generated during testing
kick_db.json
Custom_Meta.json
vault.json
Widget_Token.txt
debug.log

# Ignore sensitive config (contains API keys/tokens)
Config.json

# Ignore local game database
Forge_Database.json

# Ignore dev artifacts
not required/
**/target/
*.log

# The metadata-signer tool lives locally only (kept off the public repo
# entirely, not just its key) — only the public key it produces belongs in
# the repo, embedded in src-tauri/src/metadata_signing.rs.
tools/metadata-signer/

# Ignore Playwright MCP preview screenshots/traces
.playwright-mcp/

# Ignore local Flatpak build output (flatpak-builder state + the .deb it
# downloads to wrap + the .flatpak it produces) — only the manifests/
# metainfo under flatpak/ are source, everything else there is generated
# by running flatpak-builder, same as release.yml's flatpak job does.
flatpak/.flatpak-builder/
flatpak/build/
flatpak/repo/
flatpak/*.deb
flatpak/*.flatpak

# Ignore local portable-build staging (release.yml's portable Windows/macOS
# zip steps, if run locally)
portable-*/
*-portable-*.zip

# Ignore editor/OS junk
.vscode/
.idea/
.DS_Store
Thumbs.db
