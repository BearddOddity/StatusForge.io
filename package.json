{
  "name": "statusforge.io",
  "version": "1.0.0",
  "description": "StatusForge.io Rich Presence Engine",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "check:capabilities": "node scripts/check-capabilities.mjs",
    "tauri": "tauri",
    "docs:kick": "npx tsx ../shared/kick-mcp/fetch-kick-docs.ts --out ./kick-docs",
    "docs:kick:list": "npx tsx ../shared/kick-mcp/cli.ts list",
    "docs:kick:search": "npx tsx ../shared/kick-mcp/cli.ts search"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-notification": "^2.5.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-shell": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^4.1.10"
  }
}
